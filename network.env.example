# Copy to network.env on every Mac. Use the SAME values on all four Macs.
# These four IP addresses are examples: replace them with your actual LAN IPs.
TEAM_NAME=team1
MAC1_IP=192.168.1.11
MAC2_IP=192.168.1.12
MAC3_IP=192.168.1.13
MAC4_IP=192.168.1.14

# References are expanded safely by shared/env_loader.py, never executed.
# Leave these role aliases as references so IPs only need changing above.
DNS_IP=${MAC1_IP}
EDGE_IP=${MAC2_IP}
BACKEND_A_IP=${MAC3_IP}
BACKEND_A_PORT=3001
BACKEND_B_IP=${MAC4_IP}
BACKEND_B_PORT=3002
APP_DOMAIN=app.${TEAM_NAME}.test
API_DOMAIN=api.${TEAM_NAME}.test
HTTPS_PORT=8443

# Ordinary website lookups go to this resolver; .test stays private on Mac 1.
# Use your existing network resolver if this address is blocked by your LAN.
# Leave empty only if you deliberately want DNS for lab names alone.
UPSTREAM_DNS=8.8.8.8
